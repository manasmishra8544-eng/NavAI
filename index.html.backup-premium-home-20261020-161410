<script id="NAVAI_AUTH_AUTO_RECOVERY">
(function () {
  function recoverAuth() {
    if (document.getElementById("navai-auth-trigger")) return;

    function reloadAuth() {
      var old = document.querySelector('script[src="/auth-ui.js"]');
      if (old) old.remove();

      var script = document.createElement("script");
      script.src = "/auth-ui.js?v=" + Date.now();
      document.body.appendChild(script);
    }

    if (window.supabase) {
      reloadAuth();
      return;
    }

    var cdn = document.createElement("script");
    cdn.src = "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js";
    cdn.onload = reloadAuth;
    cdn.onerror = function () {
      console.error("NavAI sign-in recovery: Supabase library failed to load.");
    };
    document.head.appendChild(cdn);
  }

  setTimeout(recoverAuth, 1200);
})();
</script>
