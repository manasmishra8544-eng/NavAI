<script id="navai-three-dot-script">
(function(){
  if(document.getElementById("navai-three-dot-script-loaded")) return;
  var oldWrap = document.getElementById("navai-more-wrap");
  if(oldWrap) oldWrap.remove();

  var developer = /\/developer\/?$/.test(location.pathname);
  var wrap = document.createElement("div");
  wrap.id = "navai-more-wrap";
  wrap.style.cssText = "position:relative;display:inline-flex;align-items:center;flex-shrink:0;z-index:100000;margin-left:8px";
  wrap.innerHTML =
    '<button id="navai-more-button" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="navai-more-menu" style="width:38px;height:38px;display:grid;place-items:center;border:1px solid rgba(140,164,255,.27);border-radius:12px;background:linear-gradient(145deg,rgba(45,65,112,.7),rgba(15,24,45,.94));color:#eaf0ff;cursor:pointer;font:700 24px/1 system-ui;box-shadow:0 5px 20px rgba(0,0,0,.15)">⋯</button>' +
    '<nav id="navai-more-menu" aria-label="NavAI navigation" aria-hidden="true" style="position:absolute;left:0;top:calc(100% + 9px);width:245px;padding:9px;border:1px solid rgba(137,160,215,.25);border-radius:16px;background:rgba(9,16,33,.98);box-shadow:0 20px 55px rgba(0,0,0,.48);backdrop-filter:blur(22px);opacity:0;transform:translateY(-5px);pointer-events:none;transition:opacity .16s,transform .16s">' +
    '<div style="padding:8px 10px;color:#8f9fbe;font:600 10px system-ui;letter-spacing:1.4px">NAVAI WORKSPACE</div>' +
    (developer
      ? '<a href="/" style="display:flex;gap:12px;align-items:center;padding:12px 10px;border-radius:11px;color:#edf2ff;text-decoration:none;font:600 13px system-ui"><span style="font-size:20px;color:#aebfff">âŒ‚</span><span>Back to NavAI Chat<small style="display:block;color:#95a4c2;font-weight:400;margin-top:3px">Return to your conversations</small></span></a>'
      : '<a href="/developer" style="display:flex;gap:12px;align-items:center;padding:12px 10px;border-radius:11px;color:#edf2ff;text-decoration:none;font:600 13px system-ui"><span style="font-size:20px;color:#aebfff">✦</span><span>Website Developer<small style="display:block;color:#95a4c2;font-weight:400;margin-top:3px">Create websites with AI</small></span></a>') +
    '</nav>';

  var style = document.createElement("style");
  style.id = "navai-three-dot-polish";
  style.textContent =
    '#navai-more-button:hover{border-color:rgba(153,176,255,.7)!important;background:linear-gradient(145deg,rgba(69,95,163,.8),rgba(24,35,64,.98))!important;transform:translateY(-1px)}' +
    '#navai-more-menu.navai-open{opacity:1!important;transform:translateY(0)!important;pointer-events:auto!important}' +
    '#navai-more-menu a:hover{background:rgba(103,130,224,.17)!important}' +
    '#navai-more-button:focus-visible{outline:2px solid #8ba4ff;outline-offset:3px}';
  document.head.appendChild(style);

  var sidebar = document.querySelector('aside,[class*="sidebar" i],[id*="sidebar" i]');
  var selectors = [
    '[class*="brand" i]','[class*="logo" i]','[id*="logo" i]',
    '[class*="sidebar-header" i]','[class*="header-brand" i]'
  ];
  var logo = null;

  // Prefer an identifiable brand/logo inside the sidebar.
  for(var i=0;i<selectors.length && !logo;i++){
    var list = document.querySelectorAll(selectors[i]);
    for(var j=0;j<list.length;j++){
      var el=list[j];
      if(!el.getClientRects().length || wrap.contains(el)) continue;
      if(sidebar && !sidebar.contains(el) && !developer) continue;
      var t=(el.innerText||el.textContent||"").trim();
      if(/navai/i.test(t) && t.length<100){logo=el;break;}
    }
  }

  // Fallback: find a visible element whose text is exactly NavAI.
  if(!logo){
    var all=document.querySelectorAll("a,div,span,button,h1,h2");
    for(var k=0;k<all.length;k++){
      var node=all[k];
      if(!node.getClientRects().length || wrap.contains(node)) continue;
      var text=(node.innerText||node.textContent||"").replace(/[✦⋯]/g,"").trim();
      if(/^navai$/i.test(text)){
        if(!sidebar || sidebar.contains(node) || developer){logo=node;break;}
      }
    }
  }

  if(logo && logo.parentElement){
    var parent=logo.parentElement;
    parent.insertBefore(wrap,logo.nextSibling);
    // Keep the logo and menu on the same line where possible.
    var display=getComputedStyle(parent).display;
    if(display==="flex" || display==="inline-flex"){
      parent.style.alignItems="center";
      parent.style.flexWrap="nowrap";
    }
  } else if(sidebar && !developer){
    sidebar.insertBefore(wrap,sidebar.firstChild);
    wrap.style.margin="10px 12px";
  } else {
    var header=document.querySelector("header");
    if(header) header.insertBefore(wrap,header.firstChild);
    else document.body.insertBefore(wrap,document.body.firstChild);
  }

  var button=document.getElementById("navai-more-button");
  var menu=document.getElementById("navai-more-menu");

  function close(){
    menu.classList.remove("navai-open");
    menu.setAttribute("aria-hidden","true");
    button.setAttribute("aria-expanded","false");
  }
  button.addEventListener("click",function(e){
    e.stopPropagation();
    var opening=!menu.classList.contains("navai-open");
    menu.classList.toggle("navai-open",opening);
    menu.setAttribute("aria-hidden",String(!opening));
    button.setAttribute("aria-expanded",String(opening));
  });
  document.addEventListener("click",function(e){if(!wrap.contains(e.target))close();});
  document.addEventListener("keydown",function(e){if(e.key==="Escape")close();});

  var marker=document.createElement("meta");
  marker.id="navai-three-dot-script-loaded";
  document.head.appendChild(marker);
})();
</script>
