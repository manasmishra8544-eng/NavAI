@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}

/* Pico speaking and live teaching enhancements */
.mascot-wrap.is-speaking .smile {
  width: 19px;
  height: 13px;
  top: 76px;
  border: 2px solid #354a8b;
  border-top: 0;
  background: #354a8b22;
  animation: pico-talk .2s ease-in-out infinite alternate;
}
.mascot-wrap.is-speaking .pico {
  animation: float 1.4s ease-in-out infinite;
}
@keyframes pico-talk {
  from { height: 4px; border-radius: 50%; }
  to { height: 14px; border-radius: 35%; }
}
.lesson-step.active {
  box-shadow: 0 0 0 2px #75cfc422, 0 8px 24px #0002;
  transform: translateX(2px);
}
.lesson-step {
  transition: border-color .2s, background .2s, transform .2s, box-shadow .2s;
}
@media (prefers-reduced-motion: reduce) {
  .mascot-wrap.is-speaking .smile,
  .mascot-wrap.is-speaking .pico { animation: none; }
  .lesson-step { transition: none; }
}
/* Class-aware NavAI teacher stage */
.teacher-stage {
  display:flex; align-items:center; gap:24px; padding:22px 26px;
  margin:0 0 24px; border:1px solid #ffffff17; border-radius:19px;
  background:linear-gradient(120deg,#101d32,#101728 70%,#122333);
  box-shadow:0 16px 45px #0002; overflow:hidden;
}
.teacher-visual {
  flex:0 0 180px; min-height:190px; display:flex; align-items:center;
  justify-content:center; flex-direction:column; position:relative;
}
.avatar {
  width:124px; height:138px; position:relative;
  display:flex; align-items:center; flex-direction:column;
  filter:drop-shadow(0 12px 18px #0004);
  animation:teacher-float 3s ease-in-out infinite;
}
.avatar-aura {
  position:absolute; width:130px; height:115px; top:12px; border-radius:50%;
  background:radial-gradient(ellipse,#628dff2b,transparent 70%);
}
.avatar-ears { position:absolute; top:12px; width:100%; display:flex; justify-content:space-between; padding:0 2px; }
.avatar-ears i { width:31px; height:38px; border:3px solid #c1d9ff; background:#6589ed; border-radius:13px 13px 7px 7px; transform:rotate(-20deg); }
.avatar-ears i:last-child { transform:rotate(20deg); }
.avatar-head {
  position:absolute; z-index:1; top:14px; width:108px; height:91px;
  border:3px solid #c6e0ff; border-radius:44% 44% 42% 42%;
  background:linear-gradient(145deg,#b9dcff,#7ea5fa 60%,#6475e8);
  display:flex; justify-content:center;
}
.avatar-hair { display:none; }
.avatar-eyes { position:absolute; top:35px; left:20px; right:20px; display:flex; justify-content:space-between; }
.avatar-eyes i { width:17px; height:22px; border-radius:50%; background:#f8fbff; border:2px solid #e1eaff; position:relative; }
.avatar-eyes i:after { content:""; position:absolute; width:7px; height:11px; top:5px; left:4px; border-radius:50%; background:#1b3159; }
.avatar-cheeks { position:absolute; top:66px; left:8px; right:8px; display:flex; justify-content:space-between; }
.avatar-cheeks i { width:13px; height:7px; border-radius:50%; background:#ff9bb0a8; }
.avatar-mouth { position:absolute; top:68px; left:45px; width:17px; height:9px; border-bottom:3px solid #354a8b; border-radius:50%; }
.avatar-whiskers { display:none; }
.avatar-neck { position:absolute; z-index:0; top:99px; width:24px; height:15px; background:#efbf98; }
.avatar-body {
  position:absolute; bottom:0; width:78px; height:39px; border:3px solid #a4fff0;
  border-radius:17px 17px 22px 22px; background:linear-gradient(130deg,#63dfd2,#398fb9);
  display:grid; place-items:center; color:white;
}
.avatar-emblem { font-weight:800; font-size:15px; }
.avatar-name { margin-top:7px; font-size:9px; letter-spacing:1.3px; color:#a8c3f3; font-weight:700; text-align:center; }
.teacher-message { flex:1; min-width:0; }
.teacher-kicker { font-size:9px; letter-spacing:1.7px; color:#8faeff; font-weight:700; }
.teacher-message h3 { margin:8px 0; font:600 22px 'Space Grotesk',sans-serif; }
.teacher-message p { color:#aebdd3; font-size:12px; line-height:1.8; margin:0 0 13px; }
.teacher-state { display:inline-flex; align-items:center; gap:8px; font-size:10px; color:#8da5c8; background:#ffffff08; border:1px solid #ffffff12; border-radius:30px; padding:7px 10px; }
.teacher-state i { width:7px; height:7px; border-radius:50%; background:#72efd0; }
.teacher-state.is-speaking i { background:#8de7d8; box-shadow:0 0 12px #72efd0; }
.teacher-stage.teacher-speaking .avatar-mouth { animation:teacher-mouth .17s infinite alternate; }
.teacher-stage.teacher-speaking .avatar { animation:teacher-float .9s ease-in-out infinite; }
@keyframes teacher-float { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-5px); } }
@keyframes teacher-mouth { from { height:3px; } to { height:13px; background:#354a8b44; border:2px solid #354a8b; } }

/* Cute original cartoon robot-cat style for younger learners */
.avatar-cartoon .avatar-head { border-radius:46% 46% 42% 42%; background:linear-gradient(145deg,#c5eaff,#81caff 60%,#648bf0); }
.avatar-cartoon .avatar-ears i { height:31px; width:29px; background:#62b6ed; border-radius:12px 12px 5px 5px; }
.avatar-cartoon .avatar-whiskers { display:block; position:absolute; top:61px; left:-7px; right:-7px; color:#385c9b; font-size:11px; }
.avatar-cartoon .avatar-whiskers span { position:absolute; white-space:nowrap; }
.avatar-cartoon .avatar-whiskers span:first-child { left:-2px; }
.avatar-cartoon .avatar-whiskers span:last-child { right:-2px; }
.avatar-cartoon .avatar-body { background:linear-gradient(130deg,#64d8ef,#4778d9); border-color:#bceeff; }
.avatar-cartoon .avatar-neck { background:#b6e4ff; }

/* Futuristic AI tutor */
.avatar-ai .avatar-head { border-radius:28px; background:linear-gradient(145deg,#b7d4ff,#7488ed); border-color:#d6e3ff; }
.avatar-ai .avatar-ears i { height:37px; border-radius:8px; background:#7779dc; }
.avatar-ai .avatar-body { background:linear-gradient(130deg,#a5b7ff,#555ed0); border-color:#d1d5ff; }
.avatar-ai .avatar-neck { background:#9fafff; }
.avatar-ai .avatar-emblem { color:#fff; }

/* Human-like illustrated tutor, not a photorealistic person */
.avatar-human .avatar-head { background:linear-gradient(145deg,#f7d0ae,#dfa078); border:3px solid #ffe2c9; border-radius:43% 43% 47% 47%; }
.avatar-human .avatar-hair { display:block; position:absolute; top:-4px; left:0; right:0; height:34px; background:#27334c; border-radius:45px 45px 15px 15px; }
.avatar-human .avatar-eyes { top:40px; }
.avatar-human .avatar-eyes i { width:13px; height:8px; background:#fff; border:0; border-radius:50%; }
.avatar-human .avatar-eyes i:after { width:5px; height:5px; top:1px; left:4px; background:#3b3441; }
.avatar-human .avatar-cheeks { top:62px; }
.avatar-human .avatar-cheeks i { background:#df8d7c66; }
.avatar-human .avatar-mouth { top:71px; border-color:#99594f; }
.avatar-human .avatar-ears { top:40px; }
.avatar-human .avatar-ears i { width:10px; height:18px; border:0; background:#dfa078; }
.avatar-human .avatar-neck { background:#dfa078; }
.avatar-human .avatar-body { background:linear-gradient(130deg,#536ba4,#283956); border-color:#9eb9e9; border-radius:13px 13px 20px 20px; }
.avatar-human .avatar-emblem { font-size:11px; }

@media(max-width:650px) {
  .teacher-stage { padding:15px; gap:10px; }
  .teacher-visual { flex-basis:112px; transform:scale(.9); transform-origin:center; }
  .teacher-message h3 { font-size:17px; }
  .teacher-message p { font-size:11px; line-height:1.6; }
  .teacher-kicker { font-size:8px; letter-spacing:1px; }
}
@media(prefers-reduced-motion:reduce) {
  .avatar,.teacher-stage.teacher-speaking .avatar-mouth { animation:none!important; }
}
/* NAVAI CLASSROOM LIVE BOARD ANIMATION */
.board-writing-label {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 18px 0 12px;
  color: #91f3dc;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.4px;
}
.board-writing-label > span:last-child {
  margin-left: auto;
  color: #b9c8d9;
  letter-spacing: .3px;
}
.board-live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #70efd1;
  box-shadow: 0 0 12px #70efd1;
  animation: classroom-live-pulse 1.4s infinite;
}
.steps-list .lesson-step:not(.active) {
  display: none !important;
}
.lesson-step.active {
  position: relative;
  overflow: hidden;
  border-color: #80f0d5;
  background: linear-gradient(125deg, rgba(26, 75, 82, .45), rgba(14, 27, 48, .96));
  box-shadow: 0 0 28px rgba(85, 239, 207, .10);
}
.board-writing .lesson-step.active .step-copy h4 {
  animation: classroom-write-in .55s ease-out both;
}
.board-writing .lesson-step.active .step-copy p {
  animation: classroom-write-in .95s .12s ease-out both;
}
.board-writing .lesson-step.active .equation {
  animation: classroom-equation-in .7s .25s ease-out both;
}
.board-pen {
  position: absolute;
  bottom: 8px;
  left: 12px;
  width: 20px;
  height: 3px;
  border-radius: 4px;
  background: #8cf5dd;
  box-shadow: 0 0 12px #8cf5dd;
  animation: classroom-pen-move 1.7s ease-in-out infinite alternate;
  pointer-events: none;
}
.concept-current {
  color: #8cf5dd !important;
  border-color: rgba(140, 245, 221, .55) !important;
}
.teacher-stage.voice-active .avatar-head {
  animation: classroom-teacher-talk .55s ease-in-out infinite alternate;
  transform-origin: 50% 100%;
}
.teacher-stage.voice-active .avatar-mouth {
  animation: classroom-mouth-talk .22s ease-in-out infinite alternate;
  transform-origin: center;
}
.teacher-stage.voice-active .avatar-body {
  animation: classroom-teacher-sway 1.1s ease-in-out infinite alternate;
  transform-origin: 50% 0;
}
.mascot-wrap.is-speaking .pico {
  animation: classroom-pico-teach .65s ease-in-out infinite alternate;
  transform-origin: 50% 100%;
}
@keyframes classroom-live-pulse {
  50% { opacity: .35; transform: scale(.8); }
}
@keyframes classroom-write-in {
  from { opacity: .05; clip-path: inset(0 100% 0 0); transform: translateY(3px); }
  to { opacity: 1; clip-path: inset(0 0 0 0); transform: translateY(0); }
}
@keyframes classroom-equation-in {
  from { opacity: 0; transform: translateX(-8px); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes classroom-pen-move {
  from { left: 12px; }
  to { left: min(78%, 440px); }
}
@keyframes classroom-teacher-talk {
  from { transform: rotate(-2deg) translateY(0); }
  to { transform: rotate(2deg) translateY(-2px); }
}
@keyframes classroom-mouth-talk {
  from { transform: scaleY(.55); }
  to { transform: scaleY(1.35); }
}
@keyframes classroom-teacher-sway {
  from { transform: rotate(-1deg); }
  to { transform: rotate(1deg); }
}
@keyframes classroom-pico-teach {
  from { transform: translateY(0) rotate(-1deg); }
  to { transform: translateY(-3px) rotate(1deg); }
}
@media (prefers-reduced-motion: reduce) {
  .board-live-dot,
  .board-writing .lesson-step.active .step-copy h4,
  .board-writing .lesson-step.active .step-copy p,
  .board-writing .lesson-step.active .equation,
  .board-pen,
  .teacher-stage.voice-active .avatar-head,
  .teacher-stage.voice-active .avatar-mouth,
  .teacher-stage.voice-active .avatar-body,
  .mascot-wrap.is-speaking .pico {
    animation: none !important;
  }
}
/* NAVAI CLASSROOM WRITE-ON EFFECT */
.board-writing .lesson-step.active .step-copy h4,
.board-writing .lesson-step.active .step-copy p,
.board-writing .lesson-step.active .equation {
  animation: navai-write-on .7s ease-out both;
}
.board-writing .lesson-step.active .step-copy p { animation-delay: .15s; }
.board-writing .lesson-step.active .equation { animation-delay: .3s; }
@keyframes navai-write-on {
  from { opacity: 0; clip-path: inset(0 100% 0 0); }
  to { opacity: 1; clip-path: inset(0 0 0 0); }
}
@media (prefers-reduced-motion: reduce) {
  .board-writing .lesson-step.active .step-copy h4,
  .board-writing .lesson-step.active .step-copy p,
  .board-writing .lesson-step.active .equation {
    animation: none !important;
  }
}
