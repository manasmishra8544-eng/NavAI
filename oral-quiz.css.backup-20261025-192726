*{box-sizing:border-box}body{margin:0;background:#050b18;color:#edf3ff;font:16px/1.6 "Segoe UI",Arial,sans-serif}header{display:flex;justify-content:space-between;gap:12px;padding:18px 5%;border-bottom:1px solid #263654}a{color:#dbe5ff;text-decoration:none}header a:first-child{font-size:21px;font-weight:800}main{width:min(760px,92%);margin:40px auto}.panel{padding:clamp(18px,4vw,30px);border:1px solid #293b60;border-radius:20px;background:linear-gradient(145deg,#101e3a,#091328);box-shadow:0 20px 60px #0005}h1{font-size:clamp(28px,5vw,42px);line-height:1.2}.eyebrow{color:#a6b6ff;letter-spacing:2px;font-size:12px}label{display:block;color:#b9c8e5;margin:15px 0;font-size:14px}input,select,textarea{display:block;width:100%;margin-top:7px;padding:13px;border-radius:11px;border:1px solid #344767;background:#071126;color:white;font:inherit}textarea{min-height:95px;resize:vertical}button{border:0;border-radius:11px;padding:12px 16px;background:linear-gradient(100deg,#4775ff,#8956ec);color:white;font-weight:700;cursor:pointer;margin:5px 4px 5px 0}.secondary{background:#172746;border:1px solid #344767}.row{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}.bar{height:5px;background:#253451;margin:15px 0 28px}.bar div{height:100%;width:0;background:linear-gradient(90deg,#6685ff,#bd79ff)}.feedback{white-space:pre-wrap;margin:16px 0;padding:16px;border:1px solid #394c72;border-radius:12px;background:#0b1a34}.hidden{display:none!important}#status{color:#b9c8e5;font-size:13px}.review-item{padding:12px 0;border-bottom:1px solid #293b60}@media(max-width:520px){main{margin:22px auto}.row button{flex:1}}
