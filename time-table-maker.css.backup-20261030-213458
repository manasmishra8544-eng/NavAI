:root{color-scheme:dark;--bg:#080d1b;--panel:#101a30;--line:#263653;--muted:#9aabc7;--text:#f4f7ff;--blue:#69a5ff;--purple:#a58bff}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 50% -20%,#1c3260 0,transparent 55%),var(--bg);color:var(--text);font-family:Inter,Segoe UI,Arial,sans-serif;min-height:100vh}
.topbar{height:68px;border-bottom:1px solid #ffffff12;display:flex;align-items:center;justify-content:space-between;padding:0 max(22px,calc((100% - 1050px)/2))}
.brand{display:flex;align-items:center;gap:10px;color:white;text-decoration:none;font-weight:750}.brand small{display:block;font-size:9px;letter-spacing:2px;color:#9aabc7;margin-top:3px}
.brand-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:linear-gradient(135deg,#438cff,#9a6bff)}
.back{color:#b8c8e5;text-decoration:none;font-size:13px}
.wrap{width:min(920px,calc(100% - 32px));margin:0 auto}
.hero{text-align:center;padding:55px 0 34px}
.eyebrow{font-size:10px;letter-spacing:2px;color:#83b6ff;font-weight:800}
.hero h1{font-size:clamp(38px,7vw,65px);line-height:1.04;letter-spacing:-2px;margin:16px 0}
.hero h1 span{background:linear-gradient(90deg,#75b7ff,#b38aff);background-clip:text;color:transparent}
.hero p{color:var(--muted);font-size:15px;line-height:1.7;max-width:560px;margin:auto}
.panel{background:linear-gradient(145deg,#14213b,#0e172a);border:1px solid var(--line);border-radius:22px;padding:clamp(20px,4vw,34px);box-shadow:0 25px 80px #0004}
.section-title,.result-head{display:flex;justify-content:space-between;align-items:center;gap:15px}
h2{font-size:23px;margin:8px 0 0}.optional{font-size:11px;color:#9db0ce;background:#ffffff0a;border:1px solid var(--line);border-radius:20px;padding:8px 11px}
.fields{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:28px}
.field label{display:block;font-size:13px;font-weight:650;margin-bottom:10px}
.time-pair{display:flex;align-items:center;gap:9px}.time-pair span{color:#91a4c2;font-size:12px}
input{width:100%;min-width:0;background:#091326;border:1px solid #30415f;color:white;border-radius:11px;padding:13px;font:inherit;outline:none}
input:focus{border-color:var(--blue);box-shadow:0 0 0 3px #69a5ff18}
.hint,.footnote{font-size:12px;color:var(--muted);line-height:1.6;margin:20px 0}
.primary,.secondary{border:0;border-radius:12px;padding:14px 19px;font-weight:750;cursor:pointer;font-size:14px}
.primary{width:100%;background:linear-gradient(100deg,#398cff,#8969f4);color:white;box-shadow:0 9px 25px #4a78ff30}
.primary span{float:right;font-size:19px}.primary:disabled{opacity:.6;cursor:wait}
.secondary{background:#192844;color:#dce8ff;border:1px solid #344867}
.status{min-height:18px;text-align:center;color:#a9c9ff;font-size:13px;margin:13px 0 0}
.result{margin:30px 0 50px}.result-head p{color:var(--muted);font-size:13px}
.schedule{display:grid;gap:15px;margin-top:20px}
.day{background:#101b30;border:1px solid var(--line);border-radius:16px;overflow:hidden}
.day h3{font-size:15px;margin:0;padding:15px 18px;background:#172642;color:#bcd6ff}
.slot{display:grid;grid-template-columns:112px 1fr;gap:13px;padding:14px 18px;border-top:1px solid #ffffff0d}
.slot-time{font-size:12px;color:#88b7ff;font-weight:750}.slot-name{font-size:13px;font-weight:700}.slot-note{font-size:12px;color:var(--muted);margin-top:5px;line-height:1.5}
.result-actions{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap}
footer{text-align:center;color:#687b9b;font-size:11px;padding:30px}
@media(max-width:620px){.fields{grid-template-columns:1fr}.hero{padding-top:40px}.section-title,.result-head{align-items:flex-start;flex-direction:column}.slot{grid-template-columns:88px 1fr;padding:13px}.topbar{padding:0 16px}}
@media print{body{background:white;color:#172033}.topbar,.hero,.panel,.result-actions,footer{display:none!important}.wrap{width:100%}.result{display:block!important}.day{break-inside:avoid;background:white;border-color:#bbb}.day h3{background:#eee;color:#172033}.slot-time,.slot-name{color:#172033}.slot-note,.result-head p{color:#444}.eyebrow{color:#333}}
