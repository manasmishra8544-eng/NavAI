function tr(k){return (t[lang]||t.en)[k]||k}
function renderList(){
 const q=$("search").value.trim().toLowerCase();
 const items=reactions.filter(r=>(filter==="all"||r.category===filter)&&[r.en,r.hi,r.eq,r.typeEn].join(" ").toLowerCase().includes(q));
 $("reactionList").innerHTML=items.map(r=>`<button class="reaction-card ${r.id===current.id?"active":""}" data-id="${r.id}"><strong>${lang==="hi"?r.hi:r.en}</strong><small>${lang==="hi"?r.typeHi:r.typeEn} · ${r.grade}</small><div class="eq-small">${r.eq}</div></button>`).join("")||`<p style="color:var(--muted);font-size:12px">No curated reactions found.</p>`;
 $("reactionList").querySelectorAll("button").forEach(b=>b.addEventListener("click",()=>selectReaction(b.dataset.id)));
}
function selectReaction(id){current=reactions.find(r=>r.id===id)||reactions[0];step=0;answered=false;renderList();renderReaction();}
function renderReaction(){
 $("reactionTitle").textContent=lang==="hi"?current.hi:current.en;
 $("reactionSubtitle").textContent=lang==="hi"?current.subHi:current.subEn;
 $("equation").textContent=current.eq;
 $("chips").innerHTML=`<span class="chip">${lang==="hi"?current.typeHi:current.typeEn}</span><span class="chip">${current.grade}</span><span class="chip">Curated example</span>`;
 $("conservation").textContent=lang==="hi"?current.conHi:current.conEn;
 $("explanation").textContent=lang==="hi"?current.expHi:current.expEn;
 $("observation").textContent=lang==="hi"?current.obsHi:current.obsEn;
 $("sourceLine").textContent=current.source;
 $("quizQuestion").textContent=lang==="hi"?current.quizHi:current.quizEn;
 $("answers").innerHTML=(lang==="hi"?current.answersHi:current.answersEn).map((a,i)=>`<button class="answer" data-index="${i}">${String.fromCharCode(65+i)}. ${a}</button>`).join("");
 $("feedback").textContent="";$("answers").querySelectorAll("button").forEach(b=>b.addEventListener("click",()=>answerQuiz(Number(b.dataset.index),b)));
 renderStage();renderList();
}
function renderStage(){
 const atoms=current.atoms;let html="";
 atoms.forEach((a,i)=>{let [label,cls,x,y]=a;html+=`<div class="atom ${cls}" style="left:${x}px;top:${y}px;transform:translateZ(${i%2?28:-18}px)">${label}</div>`;});
 if(atoms.length>1){for(let i=0;i<atoms.length-1;i++){let a=atoms[i],b=atoms[i+1],dx=b[2]-a[2],dy=b[3]-a[3],length=Math.sqrt(dx*dx+dy*dy),angle=Math.atan2(dy,dx)*180/Math.PI;html+=`<div class="bond" style="left:${a[2]+22}px;top:${a[3]+22}px;width:${length}px;transform:rotate(${angle}deg) translateZ(-4px)"></div>`;}}
 $("molecule").innerHTML=html;
 const captions=lang==="hi"?["प्रारंभिक अवस्था · अभिकारक","परिवर्तन · कणों का पुनर्विन्यास","अंतिम अवस्था · उत्पाद / मॉडल"]:["Initial state · Reactants","Transformation · particle rearrangement","Final state · Products / model"];
 $("stageCaption").textContent=captions[step];
 $("stageStep").textContent=(step===0?"READY":step===1?"TRANSFORM":"MODEL RESULT")+" · "+String(step+1).padStart(2,"0")+" / 03";
 $("timelineFill").style.width=(step/2*100)+"%";
 $("stepLabel").textContent=(lang==="hi"?"चरण ":"Step ")+(step+1)+(lang==="hi"?" / 3":" of 3");
 $("playBtn").disabled=step===2;
 $("playBtn").style.opacity=step===2?".55":"1";
 // A conceptual, labeled transition: no unsupported reaction outcome is generated.
 $("molecule").style.filter=step===1?"drop-shadow(0 0 20px #8b8cff)":step===2?"drop-shadow(0 0 24px #62e6c1)":"drop-shadow(0 0 12px #6da7ff)";
}
function answerQuiz(index,button){
 if(answered)return;answered=true;
 const buttons=[...$("answers").querySelectorAll("button")];
 buttons[current.correct].classList.add("correct");
 if(index!==current.correct)button.classList.add("wrong");
 $("feedback").textContent=index===current.correct?(lang==="hi"?"सही जवाब! बहुत बढ़िया।":"Correct! Well done."):(lang==="hi"?"सही उत्तर हाइलाइट किया गया है।":"The correct answer is highlighted.");
}
function advance(){step=Math.min(2,step+1);renderStage();}
$("playBtn").addEventListener("click",()=>{if(step<2){advance();if(step<2)setTimeout(()=>{if(step===1)advance()},650)}});
$("stepBtn").addEventListener("click",advance);
$("resetBtn").addEventListener("click",()=>{step=0;renderStage()});
$("search").addEventListener("input",renderList);
$("filters").querySelectorAll("button").forEach(b=>b.addEventListener("click",()=>{filter=b.dataset.filter;$("filters").querySelectorAll("button").forEach(x=>x.classList.toggle("active",x===b));renderList()}));
$("langBtn").addEventListener("click",()=>{
 lang=lang==="en"?"hi":"en";document.documentElement.lang=lang;
 document.querySelectorAll("[data-i18n]").forEach(el=>{const k=el.dataset.i18n;el.textContent=tr(k)});
 $("langBtn").textContent=lang==="en"?"हिन्दी":"English";
 $("search").placeholder=lang==="hi"?"अभिक्रिया या विषय खोजें…":"Search reactions or topics…";
 $("search").setAttribute("aria-label",lang==="hi"?"अभिक्रियाएँ खोजें":"Search reactions");
 $("playBtn").querySelector("span").textContent=tr("play");
 $("stepBtn").textContent=tr("next");$("resetBtn").textContent=tr("reset");
 renderReaction();
});
$("homeBtn").addEventListener("click",()=>{if(document.referrer&&new URL(document.referrer).origin===location.origin){history.back()}else{location.href="/"}});
for(let i=0;i<18;i++){let p=document.createElement("i");p.className="particle";p.style.left=(4+Math.random()*92)+"%";p.style.top=(30+Math.random()*70)+"%";p.style.animationDelay=(-Math.random()*8)+"s";p.style.animationDuration=(5+Math.random()*7)+"s";$("stage").appendChild(p)}
renderList();renderReaction();
})();
</script>
</body>
</html>
