@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');
:root{color-scheme:dark;--bg:#080d1b;--panel:#10182a;--line:#26334b;--muted:#9aa9c2;--text:#f3f6ff;--blue:#80a8ff;--mint:#72efd0}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 12% 0%,#17254b 0,transparent 38%),radial-gradient(ellipse at 90% 20%,#102d39 0,transparent 32%),var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh}
button,input,select{font:inherit}button,a{-webkit-tap-highlight-color:transparent}button{cursor:pointer}
.topbar{height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 max(5vw,20px);border-bottom:1px solid #ffffff10;background:#080d1bcc;position:sticky;top:0;z-index:5;backdrop-filter:blur(18px)}
.brand{display:flex;align-items:center;gap:11px;color:var(--text);text-decoration:none;font-weight:700;letter-spacing:-.3px}.brand b{color:#91b3ff}.brand-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:12px;background:linear-gradient(145deg,#89b5ff,#7764ed);color:#091126;font-weight:800;font-size:19px}
.live{font-size:10px;letter-spacing:1.5px;color:#b9c7df}.live i{display:inline-block;width:7px;height:7px;background:var(--mint);border-radius:50%;margin-right:8px;box-shadow:0 0 12px #72efd0}
.back{font-size:12px;color:#c1cce0;text-decoration:none;border:1px solid var(--line);padding:9px 13px;border-radius:10px}.back:hover{border-color:#6d8ed1}
.layout{width:min(1040px,92vw);margin:auto}.welcome{display:flex;align-items:center;gap:48px;padding:42px 4% 36px;min-height:300px}.mascot-wrap{width:170px;flex:0 0 170px;height:190px;position:relative;display:flex;align-items:center;justify-content:center;flex-direction:column}
.pico{width:125px;height:132px;position:relative;filter:drop-shadow(0 15px 22px #0007);animation:float 4s ease-in-out infinite}
.antenna{position:absolute;width:5px;height:22px;background:#5fe0cf;top:-16px;left:60px;border-radius:8px;transform:rotate(8deg)}.antenna i{position:absolute;width:13px;height:13px;background:#f5c77d;border-radius:50%;top:-7px;left:-4px;box-shadow:0 0 15px #f5c77d88}
.ear{position:absolute;top:27px;width:27px;height:45px;background:linear-gradient(135deg,#6c8cff,#5363db);border:3px solid #a9c2ff;border-radius:13px}.ear-left{left:-10px;transform:rotate(-22deg)}.ear-right{right:-10px;transform:rotate(22deg)}
.face{position:absolute;inset:6px 0 15px;border-radius:43% 43% 39% 39%;background:linear-gradient(145deg,#b5d7ff,#83a5ff 54%,#6674e8);border:3px solid #d0e3ff;box-shadow:inset -8px -9px 0 #5969d522;z-index:1}
.eye{position:absolute;top:39px;width:25px;height:31px;border-radius:50%;background:#f8fbff;border:2px solid #e4edff;display:grid;place-items:center}.eye-left{left:24px}.eye-right{right:24px}.eye i{width:10px;height:15px;border-radius:50%;background:#172d58;position:relative}.eye i:after{content:"";position:absolute;width:4px;height:4px;border-radius:50%;background:white;top:2px;left:2px}
.cheek{position:absolute;top:76px;width:15px;height:8px;border-radius:50%;background:#ff8eaf99}.cheek-left{left:12px}.cheek-right{right:12px}.smile{position:absolute;width:22px;height:11px;left:50%;top:78px;transform:translateX(-50%);border-bottom:3px solid #354a8b;border-radius:0 0 20px 20px}
.collar{position:absolute;z-index:2;bottom:13px;left:33px;width:59px;height:14px;background:#f7bd70;clip-path:polygon(0 0,100% 0,70% 100%,30% 100%)}
.body{position:absolute;bottom:-2px;left:26px;width:74px;height:35px;background:linear-gradient(130deg,#63dfd2,#398fb9);border:3px solid #a4fff0;border-radius:18px 18px 24px 24px;display:grid;place-items:center;color:#eafffb;font-size:13px}
.spark{position:absolute;color:#f4cf85;font-size:22px;animation:twinkle 2s infinite}.s1{top:14px;left:7px}.s2{top:39px;right:0;font-size:17px;animation-delay:.6s}.mascot-name{font-size:9px;letter-spacing:3px;color:#8ea9df;margin-top:12px;font-weight:700}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}@keyframes twinkle{0%,100%{opacity:.45;transform:scale(.85)}50%{opacity:1;transform:scale(1.12)}}
.eyebrow{font-size:10px;font-weight:700;letter-spacing:2px;color:#8faeff;margin:0 0 12px}.welcome-copy h1{font-family:'Space Grotesk',sans-serif;font-size:clamp(30px,4.2vw,47px);line-height:1.13;letter-spacing:-1.7px;margin:0}.welcome-copy h1 span{background:linear-gradient(90deg,#8eafff,#77ead5);background-clip:text;color:transparent}.welcome-copy>p:not(.eyebrow){font-size:14px;color:#aab7ce;line-height:1.8;max-width:510px;margin:15px 0}
.mini-tags{display:flex;gap:8px;flex-wrap:wrap}.mini-tags span{font-size:10px;color:#c7d5ec;background:#ffffff08;border:1px solid #ffffff12;border-radius:30px;padding:7px 10px}
.ask-panel,.board-section,.followup{background:linear-gradient(145deg,#111b2eeb,#0e1626f5);border:1px solid #ffffff13;border-radius:19px;box-shadow:0 20px 60px #0002}.ask-panel{padding:23px 25px;margin-bottom:26px}.ask-panel form>label{display:block;font-size:10px;letter-spacing:1.6px;font-weight:700;color:#9dacca;margin-bottom:12px}
.ask-row{display:flex;gap:10px}.ask-row input,.follow-row input{min-width:0;flex:1;background:#090f1e;border:1px solid #2b3953;border-radius:11px;padding:15px 16px;color:var(--text);outline:none;font-size:13px}.ask-row input:focus,.follow-row input:focus{border-color:#7d9ef0;box-shadow:0 0 0 3px #7d9ef018}.ask-row button{border:0;border-radius:11px;padding:0 19px;background:linear-gradient(120deg,#8fb5ff,#a4a1ff);color:#0a1530;font-weight:700;font-size:12px;display:flex;gap:13px;align-items:center}.ask-row button:disabled{opacity:.55;cursor:wait}
.options-row{display:flex;align-items:center;gap:20px;margin-top:14px;flex-wrap:wrap}.select-label{font-size:11px;color:#a8b6cd;display:flex;align-items:center;gap:7px}.select-label select{background:#151f33;border:1px solid #2a3852;color:#dce6f8;border-radius:8px;padding:6px;font-size:11px}.free-note{font-size:10px;color:#7e91b0;margin-left:auto}
.suggestions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:19px;padding-top:17px;border-top:1px solid #ffffff0d}.suggestions>span{font-size:9px;letter-spacing:1.2px;color:#8192b0;margin-right:4px}.suggestions button{border:1px solid #2a3952;background:#151f32;color:#c4d3ed;border-radius:30px;padding:8px 11px;font-size:10px}.suggestions button:hover{border-color:#8aa8ff;background:#202e49}
.board-section{padding:24px;margin-bottom:22px}.board-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.board-top .eyebrow{margin-bottom:6px}.board-top h2{font-family:'Space Grotesk',sans-serif;margin:0;font-size:22px;letter-spacing:-.5px}.board-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--mint);vertical-align:middle;margin-left:5px}
.board-controls{display:flex;align-items:center;gap:10px}.board-controls span{font-size:10px;color:#91a2c0;min-width:95px;text-align:center}.icon-btn{width:31px;height:31px;border:1px solid #31415e;background:#151f33;border-radius:9px;color:#d7e3fa}.icon-btn:disabled{opacity:.3;cursor:default}
.status{font-size:11px;color:#8fa4c6;padding:10px 13px;background:#080f1c;border:1px solid #1d2b43;border-radius:9px;margin-bottom:12px}.status.error{color:#ffb5b5;border-color:#6d343f}.status.loading{color:#a9c5ff}
.board{position:relative;min-height:310px;border-radius:13px;overflow:hidden;padding:25px;background-color:#0a1522;background-image:linear-gradient(#25465a30 1px,transparent 1px),linear-gradient(90deg,#25465a30 1px,transparent 1px);background-size:25px 25px;border:1px solid #36566a}
.empty-board{min-height:260px;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;position:relative}.board-doodle{position:absolute;top:10px;left:15px;color:#8bafc2;font:22px Georgia;opacity:.45}.board-doodle span{color:#79dfcf}.empty-orb{width:54px;height:54px;display:grid;place-items:center;border-radius:18px;background:#193c4a;color:#7ee6d1;font-size:24px;box-shadow:0 0 30px #4ad9cc15}.empty-board h3{font-size:17px;margin:15px 0 7px}.empty-board p{font-size:12px;line-height:1.7;color:#9baec4;margin:0}
.lesson-heading{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;border-bottom:1px solid #ffffff18;padding-bottom:17px;margin-bottom:17px}.lesson-heading h3{font:600 25px 'Space Grotesk',sans-serif;margin:0 0 8px;line-height:1.25}.lesson-heading p{font-size:12px;line-height:1.8;color:#b8cadb;margin:0;max-width:700px}.lesson-chip{flex-shrink:0;font-size:9px;letter-spacing:1px;color:#8bead8;background:#153b3c;border:1px solid #2e6560;padding:7px 9px;border-radius:30px}
.lesson-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(200px,.8fr);gap:15px}.steps-list{display:grid;gap:10px;align-content:start}.lesson-step{display:flex;gap:12px;padding:14px;border:1px solid #294456;border-radius:11px;background:#102331a8;transition:border-color .2s}.lesson-step.active{border-color:#75cfc4;background:#12313b}.step-number{width:28px;height:28px;flex-shrink:0;display:grid;place-items:center;background:#223e56;color:#a8d6f0;border-radius:9px;font-size:11px;font-weight:700}.lesson-step.active .step-number{background:#76d9cb;color:#09212a}.step-copy h4{margin:2px 0 6px;font-size:12px;color:#e7f5ff}.step-copy p{margin:0;color:#b2c5d5;font-size:11px;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere}.equation{margin-top:8px;padding:9px 10px;background:#07121e;border-radius:7px;color:#8ff0db;font:13px 'Space Grotesk',sans-serif;overflow-wrap:anywhere}
.visual-card{border:1px solid #2c4659;background:#0c1c29;border-radius:12px;padding:16px;min-height:200px;align-self:start}.visual-card h4{font-size:10px;letter-spacing:1.3px;text-transform:uppercase;color:#8ddfd1;margin:0 0 15px}.visual-card p{font-size:11px;color:#a9c1d1;line-height:1.8}.concept-list{display:grid;gap:8px}.concept{padding:10px;border:1px solid #2c485a;border-radius:8px;color:#d5e8f4;font-size:11px;background:#112634}.concept span{color:#79ddcf;margin-right:7px}.takeaway{margin-top:14px;padding:14px;border-left:3px solid #72dfcc;background:#12302f88;border-radius:0 9px 9px 0}.takeaway b{display:block;font-size:10px;color:#83ead8;margin-bottom:5px}.takeaway p{margin:0;font-size:11px;line-height:1.8;color:#d0e5e3}.lesson-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px}.action-primary,.action-secondary{padding:10px 13px;border-radius:9px;font-size:11px;font-weight:600}.action-primary{border:0;background:#8de7d8;color:#08232b}.action-secondary{border:1px solid #2c3e56;background:#131e30;color:#cad8ec}.lesson-actions[hidden]{display:none}
.followup{display:flex;gap:15px;padding:21px 23px;align-items:flex-start}.followup-icon{width:35px;height:35px;flex-shrink:0;display:grid;place-items:center;background:#202f50;color:#9bb7ff;border-radius:11px;font-size:20px}.followup-content{flex:1;min-width:0}.followup h3{font:600 15px 'Space Grotesk',sans-serif;margin:1px 0 5px}.followup p{font-size:11px;color:#92a4bf;margin:0 0 13px}.follow-row{display:flex;gap:9px}.follow-row input{padding:11px 13px;font-size:11px}.follow-row button{border:1px solid #425982;background:#1d2b45;color:#d7e4ff;border-radius:10px;padding:0 14px;font-size:11px}
footer{padding:24px 3px 30px;display:flex;justify-content:space-between;gap:12px;color:#657894;font-size:10px}footer span{color:#8194b3}
@media(max-width:650px){.topbar{height:62px;padding:0 4vw}.live{display:none}.layout{width:92vw}.welcome{padding:27px 0 25px;gap:13px;min-height:0}.mascot-wrap{width:110px;flex-basis:110px;transform:scale(.83);transform-origin:center}.welcome-copy h1{font-size:29px;letter-spacing:-1px}.welcome-copy>p:not(.eyebrow){font-size:12px;line-height:1.65}.mini-tags{gap:5px}.mini-tags span{font-size:9px;padding:6px 7px}.ask-panel,.board-section{padding:16px}.ask-row{flex-direction:column}.ask-row button{justify-content:center;padding:13px}.options-row{gap:11px}.free-note{width:100%;margin-left:0}.suggestions{gap:6px}.suggestions>span{width:100%;margin-bottom:3px}.board-top{align-items:flex-start}.board-top h2{font-size:19px}.board-controls{gap:5px}.board-controls span{min-width:76px;font-size:9px}.board{padding:15px;min-height:290px}.lesson-grid{grid-template-columns:1fr}.lesson-heading h3{font-size:21px}.lesson-chip{display:none}.visual-card{min-height:0}.followup{padding:16px;gap:10px}.follow-row input{width:100%}footer{flex-direction:column;gap:7px}.back{font-size:10px;padding:8px}.brand{font-size:12px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
